# Required: Neon PostgreSQL connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate a random secret, e.g. openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# NokosPusat API key from its workspace dashboard (never put in frontend)
NOKOS_API_KEY=YOUR_NOKOSPUSAT_API_KEY
NOKOS_BASE_URL=https://nokospusat.com

# Midtrans dashboard keys
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# Optional: provider display markup in percent. Default 0; no price is invented.
# Customer price = upstream offer price + fixed markup, if configured.
PRICE_MARKUP_IDR=0

# Supabase Auth (Google OAuth + public browser client config)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
